# ============================================================
#  Environment Variables Template
#  环境变量模板
# ============================================================
# 复制此文件为 .env 并修改为实际配置
# Copy this file to .env and modify for your environment
# ============================================================

# ============================================================
#  Database
#  数据库配置
# ============================================================
DB_PASSWORD=replace-with-a-strong-password

# ============================================================
#  Redis
#  Redis配置（留空表示无密码）
# ============================================================
REDIS_PASSWORD=

# ============================================================
#  JWT
#  JWT密钥（生产环境务必修改！）
# ============================================================
JWT_SECRET=please-change-this-secret-in-production-2024
AGENT_SERVICE_TOKEN=replace-with-a-long-random-secret

# ============================================================
#  Service Ports (optional)
#  服务端口（可选）
# ============================================================
# MYSQL_PORT=3306
# REDIS_PORT=6379
# BACKEND_PORT=9090
# AI_SERVICE_PORT=5000
# NGINX_HTTP_PORT=80

# ============================================================
#  File Paths (optional, defaults work for local dev)
#  文件路径（可选，本地开发用默认相对路径即可）
# ============================================================
# 上传文件目录（默认 ./files/，相对后端工作目录）
# FILE_UPLOAD_PATH=./files/
# AI服务脚本目录（默认 ../ai-service/）
# PYTHON_SCRIPT_PATH=../ai-service/
# Python解释器（默认取 PATH 中的 python，Windows可指定如 D:/Python312/python.exe）
# PYTHON_EXECUTABLE=python
# 在线训练脚本（默认 ../ai-service/archive/train_model_online.py）
# PYTHON_TRAIN_CODE=../ai-service/archive/train_model_online.py
# 在线预测脚本（默认 ../ai-service/archive/predict_online.py）
# PYTHON_PREDICT_CODE=../ai-service/archive/predict_online.py
# 训练数据目录（默认 ./data/train/）
# TRAIN_FILE_PATH=./data/train/
# 预测文件目录（默认 ./data/predictfile/）
# PREDICT_FILE_PATH=./data/predictfile/
# 融合模型文件（默认 ../ai-service/models/fusion_model.joblib）
# PREDICT_MODEL_PATH=../ai-service/models/fusion_model.joblib
