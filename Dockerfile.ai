# ============================================================
#  Python AI Service Dockerfile
#  AI反诈骗检测系统 - Python AI微服务
# ============================================================
# Build context: project root directory
# 构建上下文：项目根目录
# ============================================================

FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for audio/image processing
# 安装音频/图像处理的系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer caching)
# 先复制依赖清单（层缓存优化）
COPY ai-service/flask_app/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# Copy all Python code
# 复制所有Python代码
COPY ai-service/ ./ai-service/

# Set Python path
# 设置Python路径
ENV PYTHONPATH=/app/ai-service

# Environment variables
ENV AI_SERVICE_HOST=0.0.0.0
ENV AI_SERVICE_PORT=5000
ENV AI_SERVICE_DEBUG=false

# Expose port
# 暴露端口
EXPOSE 5000

# Health check
# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health')" || exit 1

# Start Flask service with gunicorn for production
# 使用gunicorn启动Flask服务（生产环境）
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5000", "--chdir", "ai-service/flask_app", "app:app"]
